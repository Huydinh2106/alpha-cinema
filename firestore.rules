rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chỉ người dùng Authentication mới được đọc/ghi
    function isAuthenticated() { return request.auth != null; }
    // Người dùng chỉ có quyền trên dữ liệu của chính mình
    function isOwner(uid) { return request.auth.uid == uid; }
    function likedByBefore() {
      return resource.data.likedBy is list ? resource.data.likedBy : [];
    }
    function isCommentLikeToggle() {
      return isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy', 'updatedAt']) &&
        request.resource.data.likedBy is list &&
        request.resource.data.likes is number &&
        request.resource.data.likes == request.resource.data.likedBy.size() &&
        request.resource.data.likedBy.size() >= 0 &&
        request.resource.data.likedBy.size() <= 10000 &&
        ((request.auth.uid in request.resource.data.likedBy) != (request.auth.uid in likedByBefore())) &&
        (
          request.resource.data.likedBy.size() == likedByBefore().size() + 1 ||
          request.resource.data.likedBy.size() == likedByBefore().size() - 1
        );
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
      
      match /watch_history/{movieId} {
        allow read, write: if isOwner(userId);
      }
      
      match /favorites/{movieId} {
        allow read, write: if isOwner(userId);
      }
      
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /home_categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /momoOrders/{orderId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /movies/{movieId} {
      allow read: if true;
      // Only admin users can write movies
      allow write: if isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          isCommentLikeToggle()
        );
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
      
      match /ratings/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }
  }
}
