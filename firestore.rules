rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chỉ người dùng Authentication mới được đọc/ghi
    function isAuthenticated() { return request.auth != null; }
    // Người dùng chỉ có quyền trên dữ liệu của chính mình
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function subscriptionManagedKeys() {
      return [
        'subscriptionPlan',
        'subscriptionStatus',
        'subscriptionStartedAt',
        'subscriptionExpiresAt',
        'subscriptionUpdatedAt',
        'subscriptionPaymentMethod',
        'isAdmin'
      ];
    }
    function isClientSafeUserCreate() {
      return !request.resource.data.keys().hasAny(subscriptionManagedKeys());
    }
    function isClientSafeUserUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(subscriptionManagedKeys());
    }
    function hasActivePaidPlan(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.subscriptionStatus == 'active' &&
        get(/databases/$(database)/documents/users/$(uid)).data.subscriptionPlan in ['basic', 'couple', 'premium'] &&
        get(/databases/$(database)/documents/users/$(uid)).data.subscriptionExpiresAt is timestamp &&
        get(/databases/$(database)/documents/users/$(uid)).data.subscriptionExpiresAt > request.time;
    }
    function likedByBefore() {
      return resource.data.get('likedBy', []) is list ? resource.data.get('likedBy', []) : [];
    }
    function isCommentLikeToggle() {
      return isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy', 'updatedAt']) &&
        request.resource.data.likedBy is list &&
        request.resource.data.likes is number &&
        request.resource.data.likes == request.resource.data.likedBy.size() &&
        request.resource.data.likedBy.size() >= 0 &&
        request.resource.data.likedBy.size() <= 10000 &&
        ((request.auth.uid in request.resource.data.likedBy) != (request.auth.uid in likedByBefore())) &&
        (
          request.resource.data.likedBy.size() == likedByBefore().size() + 1 ||
          request.resource.data.likedBy.size() == likedByBefore().size() - 1
        );
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isClientSafeUserCreate();
      allow update: if isOwner(userId) && isClientSafeUserUpdate();
      allow delete: if false;
      
      match /watch_history/{movieId} {
        allow read, write: if isOwner(userId);
      }
      
      match /favorites/{movieId} {
        allow read, write: if isOwner(userId);
      }

      match /playlists/{playlistId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && hasActivePaidPlan(userId);

        match /items/{movieId} {
          allow read: if isOwner(userId);
          allow create, update, delete: if isOwner(userId) && hasActivePaidPlan(userId);
        }
      }

      match /playlists_kids/{playlistId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && hasActivePaidPlan(userId);

        match /items/{movieId} {
          allow read: if isOwner(userId);
          allow create, update, delete: if isOwner(userId) && hasActivePaidPlan(userId);
        }
      }
      
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /home_categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /momoOrders/{orderId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /movies/{movieId} {
      allow read: if true;
      // Only admin users can write movies
      allow write: if isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          isCommentLikeToggle()
        );
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
      
      match /ratings/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }
  }
}
