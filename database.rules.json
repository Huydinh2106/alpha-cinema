{
  "rules": {
    "watchParty": {
      "$roomId": {
        ".read": "auth != null",
        ".write": false,
        "playbackState": {
          ".write": "auth != null && root.child('watchParty').child($roomId).child('hostId').val() == auth.uid",
          ".validate": "newData.val() == 'playing' || newData.val() == 'paused'"
        },
        "currentTimeSec": {
          ".write": "auth != null && root.child('watchParty').child($roomId).child('hostId').val() == auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "playStartedAt": {
          ".write": "auth != null && root.child('watchParty').child($roomId).child('hostId').val() == auth.uid",
          ".validate": "newData.val() == 0 || newData.val() == now"
        },
        "lastUpdated": {
          ".write": "auth != null && root.child('watchParty').child($roomId).child('hostId').val() == auth.uid",
          ".validate": "newData.val() == now"
        },
        "movieSlug": {
          ".write": "auth != null && root.child('watchParty').child($roomId).child('hostId').val() == auth.uid",
          ".validate": "newData.isString()"
        },
        "movieTitle": {
          ".write": "auth != null && root.child('watchParty').child($roomId).child('hostId').val() == auth.uid",
          ".validate": "newData.isString()"
        },
        "moviePosterUrl": {
          ".write": "auth != null && root.child('watchParty').child($roomId).child('hostId').val() == auth.uid",
          ".validate": "newData.isString()"
        },
        "episodeId": {
          ".write": "auth != null && root.child('watchParty').child($roomId).child('hostId').val() == auth.uid",
          ".validate": "newData.isString()"
        },
        "episodeName": {
          ".write": "auth != null && root.child('watchParty').child($roomId).child('hostId').val() == auth.uid",
          ".validate": "newData.isString()"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('watchParty').child($roomId).exists()",
            ".validate": "newData.hasChildren(['uid', 'displayName', 'photoUrl']) && newData.child('uid').val() == auth.uid && newData.child('displayName').isString() && newData.child('photoUrl').isString()"
          }
        },
        "chat": {
          "$messageId": {
            ".write": "auth != null && root.child('watchParty').child($roomId).child('members').child(auth.uid).exists() && !data.exists() && newData.child('uid').val() == auth.uid",
            ".validate": "newData.hasChildren(['uid', 'displayName', 'text', 'timestamp']) && newData.child('uid').isString() && newData.child('displayName').isString() && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 1000 && newData.child('timestamp').val() == now"
          }
        }
      }
    }
  }
}
