<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Theme chính dùng sau Splash -->
    <!-- Chuyển sang DayNight để hệ thống biết App hỗ trợ cả Dark Mode -->
    <style name="Theme.AlphaCinema" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <!-- Tắt bảo vệ tương phản trên Android 10+ (API 29) -->
        <!-- Yêu cầu phải có xmlns:tools ở trên để hoạt động và không báo lỗi API level -->
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>

        <!-- Đảm bảo nền status bar luôn trong suốt ở tầng Window -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- System Splash Screen của Android 12+ được "vô hiệu hoá" bằng cách:
         - Nền tối đúng màu app (#000000)
         - Icon trong suốt hoàn toàn → KHÔNG thấy gì cả
         Kết quả: người dùng chỉ thấy màn đen → fade vào Splash của mình -->
    <style name="Theme.AlphaCinema.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <!-- Icon trong suốt = không hiện gì -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/transparent_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_bg</item>
        <!-- Thời gian hiển thị tối thiểu = 0 → tắt ngay -->
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.AlphaCinema</item>
    </style>
</resources>
